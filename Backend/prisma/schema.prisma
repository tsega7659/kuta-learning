datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  CONTENT_MANAGER
}

enum ContentType {
  TEXT
  VIDEO
  AUDIO
  IMAGE
  DOCUMENT
}

enum QuestionType {
  SINGLE_CHOICE
  COLOR_MATCH
  WORD_ORDER
  MULTIPLE_CHOICE
  MATCHING
  TRUE_FALSE
  FILL_IN_BLANK
  DRAG_AND_DROP
  
}

model User {
  id               String                @id @default(uuid())
  email            String                @unique
  passwordHash     String
  role             Role                  @default(STUDENT)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  studentProfile   StudentProfile?
  lessonProgress   LessonProgress[]
  quizAttempts     QuizAttempt[]
  practiceAttempts PracticeAttempt[]
  examAttempts     NationalExamAttempt[]
  noteProgress     NoteProgress[]
}

model StudentProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  gradeLevel          Int      // 1 to 12
  stream              String?  // NATURAL, SOCIAL, or null
  isPremium           Boolean  @default(false)
  onboardingCompleted Boolean  @default(false)
  avatarUrl           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Course {
  id          String    @id @default(uuid())
  title       String
  description String
  coverImage  String?
  gradeLevel  Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  chapters    Chapter[]
}

model Chapter {
  id          String   @id @default(uuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  coverImage  String?
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  topics      Topic[]
  
  @@unique([courseId, order])
}

model Topic {
  id          String   @id @default(uuid())
  chapterId   String
  chapter     Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title       String
  description String?
  coverImage  String?
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lessons     Lesson[]
  quiz        Quiz[]
  practiceAttempts PracticeAttempt[]
  bankQuestions BankQuestion[]

  @@unique([chapterId, order])
}

model Lesson {
  id          String          @id @default(uuid())
  topicId     String
  topic       Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title       String
  description String?
  coverImage  String?
  order       Int
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  contents    LessonContent[]
  progress    LessonProgress[]

  @@unique([topicId, order])
}

model LessonContent {
  id          String      @id @default(uuid())
  lessonId    String
  lesson      Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type        ContentType
  content     String      // Text markdown, S3 URL, YouTube embed, etc.
  description String?     // Admin-supplied label, e.g. "Hear the Word!"
  order       Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Quiz {
  id           String        @id @default(uuid())
  topicId      String
  topic        Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title        String
  description  String?       // Optional short description shown to students
  passingScore Int           // As a percentage
  quizType     String        @default("QUIZ") // QUIZ or BANK
  order        Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  questions    Question[]
  attempts     QuizAttempt[]
}

model Question {
  id          String           @id @default(uuid())
  quizId      String
  quiz        Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type        QuestionType     @default(SINGLE_CHOICE)
  text        String
  resourceUrl String?          // For image-based questions
  explanation String?
  order       Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  options     QuestionOption[]
  answers     QuizAnswer[]
  practiceAnswers PracticeAnswer[]
}

model QuestionOption {
  id          String       @id @default(uuid())
  questionId  String
  question    Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text        String
  isCorrect   Boolean      @default(false)
  imageUrl    String?      // Used for Color Match / image choice quizzes
  order       Int
  answers     QuizAnswer[]
  practiceAnswers PracticeAnswer[]
}

model LessonProgress {
  id          String   @id @default(uuid())
  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed   Boolean  @default(false)
  completedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([studentId, lessonId])
}

model QuizAttempt {
  id             String        @id @default(uuid())
  studentId      String
  student        User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quizId         String
  quiz           Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score          Int
  maxScore       Int
  correctAnswers Int           @default(0)
  passed         Boolean
  startedAt      DateTime?     @default(now())
  submittedAt    DateTime?     @default(now())
  createdAt      DateTime      @default(now())
  answers        QuizAnswer[]
}

model QuizAnswer {
  id               String          @id @default(uuid())
  attemptId        String
  attempt          QuizAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String?
  selectedOption   QuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: Cascade)
  textResponse     String?         // Stores letter sequencing for Word Order questions
  isCorrect        Boolean
}

model PracticeAttempt {
  id             String         @id @default(uuid())
  studentId      String
  student        User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topicId        String
  topic          Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  score          Int
  maxScore       Int
  correctAnswers Int            @default(0)
  passed         Boolean
  startedAt      DateTime?      @default(now())
  submittedAt    DateTime?      @default(now())
  createdAt      DateTime       @default(now())
  answers        PracticeAnswer[]
}

model PracticeAnswer {
  id               String          @id @default(uuid())
  attemptId        String
  attempt          PracticeAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String?
  selectedOption   QuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: Cascade)
  textResponse     String?         
  isCorrect        Boolean
}

// ── Standalone Question Bank (separate from Quiz questions) ──

model BankQuestion {
  id          String               @id @default(uuid())
  topicId     String
  topic       Topic                @relation(fields: [topicId], references: [id], onDelete: Cascade)
  type        QuestionType         @default(SINGLE_CHOICE)
  text        String
  resourceUrl String?
  explanation String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  options     BankQuestionOption[]
}

model BankQuestionOption {
  id         String       @id @default(uuid())
  questionId String
  question   BankQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean      @default(false)
  imageUrl   String?
  order      Int
}

// ── Grade 6, 8, 12 National Exams & Short Notes ──

enum StreamType {
  NATURAL
  SOCIAL
  COMMON
}

enum ExamAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  ABANDONED
}

model ExamSubject {
  id            String         @id @default(uuid())
  name          String
  code          String?
  gradeLevels   Int[]
  stream        StreamType?
  description   String?
  subcategories String?
  icon          String?
  color         String?
  order         Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  exams         NationalExam[]
  chapters      NoteChapter[]
}

model NationalExam {
  id              String                @id @default(uuid())
  subjectId       String
  subject         ExamSubject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title           String
  year            Int
  gradeLevel      Int
  stream          StreamType?
  durationMinutes Int                   @default(120)
  passingScore    Int                   @default(50)
  isPremium       Boolean               @default(false)
  order           Int                   @default(0)
  coverImage      String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  questions       ExamQuestion[]
  attempts        NationalExamAttempt[]

  @@unique([subjectId, year, gradeLevel])
}

model ExamQuestion {
  id          String               @id @default(uuid())
  examId      String
  exam        NationalExam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  type        QuestionType         @default(SINGLE_CHOICE)
  text        String
  resourceUrl String?
  explanation String?
  order       Int
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  options     ExamQuestionOption[]
  answers     NationalExamAnswer[]

  @@unique([examId, order])
}

model ExamQuestionOption {
  id         String               @id @default(uuid())
  questionId String
  question   ExamQuestion         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean              @default(false)
  imageUrl   String?
  order      Int
  answers    NationalExamAnswer[]

  @@unique([questionId, order])
}

model NationalExamAttempt {
  id                   String               @id @default(uuid())
  studentId            String
  student              User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examId               String
  exam                 NationalExam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  status               ExamAttemptStatus    @default(IN_PROGRESS)
  score                Int                  @default(0)
  maxScore             Int                  @default(0)
  correctAnswers       Int                  @default(0)
  incorrectAnswers     Int                  @default(0)
  accuracyPercentage   Float                @default(0)
  passed               Boolean              @default(false)
  timeRemainingSeconds Int?
  startedAt            DateTime             @default(now())
  submittedAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  answers              NationalExamAnswer[]
}

model NationalExamAnswer {
  id               String              @id @default(uuid())
  attemptId        String
  attempt          NationalExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  question         ExamQuestion        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String?
  selectedOption   ExamQuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)
  textResponse     String?
  isFlagged        Boolean             @default(false)
  isCorrect        Boolean             @default(false)

  @@unique([attemptId, questionId])
}

model NoteChapter {
  id                 String         @id @default(uuid())
  subjectId          String
  subject            ExamSubject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  gradeLevel         Int
  stream             StreamType?
  title              String
  subtitle           String?
  description        String?
  order              Int            @default(0)
  pdfUrl             String?
  fileSize           String?
  content            String?
  learningObjectives String[]
  resources          Json?
  isPremium          Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  progress           NoteProgress[]

  @@unique([subjectId, gradeLevel, order])
}

model NoteProgress {
  id             String       @id @default(uuid())
  studentId      String
  student        User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  chapterId      String
  chapter        NoteChapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  isRead         Boolean      @default(false)
  readPercentage Int          @default(0)
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([studentId, chapterId])
}